{
    "name": "kaungsithu883/laravel-offline",
    "description": "Durable browser drafts and idempotent offline form synchronization for Laravel.",
    "keywords": ["laravel", "offline", "pwa", "indexeddb", "idempotency"],
    "homepage": "https://github.com/Kaungsithu883/laravel-offline",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kaungsithu883",
            "email": "ksithu883@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Kaungsithu883/laravel-offline/issues",
        "source": "https://github.com/Kaungsithu883/laravel-offline"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": { "psr-4": { "Sithu\\Offline\\": "src/" } },
    "extra": { "laravel": { "providers": ["Sithu\\Offline\\OfflineServiceProvider"] } }
}
